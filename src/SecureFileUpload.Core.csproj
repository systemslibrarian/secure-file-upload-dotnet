  <!-- ── Runtime dependencies ─────────────────────────────────────────── -->
  <!--
    Microsoft.AspNetCore.App ships as a shared framework on the target machine —
    referencing it here means it will NOT be bundled inside the package.
    Resolves to the matching ASP.NET Core 8.0 / 9.0 / 10.0 shared framework for
    each TFM. Consumers need ASP.NET Core present at one of those versions.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Image identification + recompression (polyglot-tail mitigation).

      Pinned BELOW 4.0.0 deliberately. ImageSharp moved to a commercial Six Labors
      license at v4: the build fails with "No Six Labors license found" unless a paid
      license key is supplied, and shipping it would push that obligation onto every
      consumer of this package. 3.1.x remains available under the Six Labors Split
      License, which covers open-source use.

      The range still admits 3.1.x patches, which matters — ImageSharp is fed
      attacker-controlled bytes by design, so its security advisories must keep
      reaching this package. Revisit only if a Six Labors license is acquired.
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.0" />

    <!--
      Argon2id key derivation for the master Key Encryption Key (KEK).
      Memory-hard KDF; RFC 9106; OWASP 2024+ recommendation.
      Used in FileUploadService for the Argon2id KEK derivation path.
    -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- Source Link: maps debug symbols back to the GitHub source tree -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <!-- ── Source file layout ────────────────────────────────────────────── -->
  <!--
    All source lives directly in src/ alongside this project file.
